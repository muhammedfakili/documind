# --- LLM (answer generation) --------------------------------------------------
# Only ONE key is needed -- whichever provider LLM_PROVIDER names.
#   gemini    free tier, no credit card: https://aistudio.google.com/apikey
#   anthropic paid:                      https://console.anthropic.com
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Leave empty to use the provider's default model
# (gemini-3.5-flash-lite / claude-opus-5 / nvidia/nemotron-3-ultra-550b-a55b).
LLM_MODEL=

# --- Evaluation judge (A7) ------------------------------------------------------
# Grades the answers with a model from another family. Free key: https://build.nvidia.com
NVIDIA_API_KEY=
JUDGE_PROVIDER=nvidia
# Empty = provider default (nvidia/nemotron-3-ultra-550b-a55b)
JUDGE_MODEL=

# --- Vector store -------------------------------------------------------------
# Matches the db service in docker-compose.yml (host port 5433 so it does not
# collide with a PostgreSQL you may already run on 5432). For local runs only:
# inside `docker compose up` the API container talks to the db service directly.
DATABASE_URL=postgresql://documind:documind@localhost:5433/documind

# --- API (A11) ----------------------------------------------------------------
# Needed for POST /ingest and for questions with audience="all" (internal documents).
# Any long random string, sent by the caller in the X-API-Key header. Empty = both off.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
